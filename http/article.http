// 게시물 목록 조회
// offset 기반 조회; default: offset=0, limit=10
// 
GET {{baseUrl}}/articles?limit=22
Authorization: Bearer {{accessToken}}
###
GET {{baseUrl}}/articles?order=recent&offset=10
Authorization: Bearer {{accessToken}}

// 게시물 목록 조회
// title 또는 content에 포함된 단어로 검색
// title과 content에 포함된 단어로 검색
###
GET {{baseUrl}}/articles?title=전망
Authorization: Bearer {{accessToken}}
###
GET {{baseUrl}}/articles?content=현실
Authorization: Bearer {{accessToken}}
###
GET {{baseUrl}}/articles?title=사촌&content=연기
Authorization: Bearer {{accessToken}}




// 게시물 상세 조회 및 좋아요 기능: 인증 필요
###
GET {{baseUrl}}/articles/21
Authorization: Bearer {{accessToken}}

###
POST {{baseUrl}}/articles/14/like/toggle
Authorization: Bearer {{accessToken}}


// 게시물 생성: 인증 필요
###
POST {{baseUrl}}/articles
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "전망 좋은 방",
  "content": "격정의 이태리에서 성에 눈뜨는 영국 처녀의 이야기. 배경은 20세가 초중반 런던 근교와 이태리 플로렌스."
}

// 게시물 수정과 삭제: 인증과 인가 필요
###
PATCH {{baseUrl}}/articles/25
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "content": "20세기 초반 격정의 이태리에서 성에 눈뜨는 영국 처녀의 코믹 로맨스."
}

###
DELETE {{baseUrl}}/articles/25
Authorization: Bearer {{accessToken}}


