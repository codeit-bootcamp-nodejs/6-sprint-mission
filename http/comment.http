@baseUrl = http://localhost:3000


// 댓글 목록 조회: cursor 기반
// 첫 조회: offset=0, cursor=undefined
###
GET {{baseUrl}}/comments
###
GET {{baseUrl}}/comments?type=all&cursor=90
###
GET {{baseUrl}}/comments?type=product&limit=3&cursor=3
###
GET {{baseUrl}}/comments?type=article&content=연기



// 댓글 조회
###
GET {{baseUrl}}/comments/24


// 댓글 등록: 인증
###
POST {{baseUrl}}/comments/articles/17
Content-Type: application/json

{
  "content": "유명한 죠커 연기죠"
}
###
POST {{baseUrl}}/comments/products/29
Content-Type: application/json

{
  "content": "여자손에 맞는 크기"
}

// 댓글 수정과 삭제: 인증과 인가
###
PATCH {{baseUrl}}/comments/94
Content-Type: application/json

{
  "content": "너무 웃겨요!"
}

###
DELETE {{baseUrl}}/comments/99