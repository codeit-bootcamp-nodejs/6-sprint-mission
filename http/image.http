@baseUrl = http://localhost:3000

//------------------------상품 이미지 APIs
GET {{baseUrl}}/images/products/12
###
GET {{baseUrl}}/images/products/32/1770697009465.png

// 토큰 인증 + 인가 (상품을 등록한 유저만 가능)
###
POST {{baseUrl}}/images/products/12
Content-Type: multipart/form-data; boundary=MyBoundary

--MyBoundary
Content-Disposition: form-data; name="image"; filename="kindle11.png"
Content-Type: image/png

< ./images/product/kindle11.png
--MyBoundary--

###
DELETE {{baseUrl}}/images/products/12
###
DELETE {{baseUrl}}/images/products/12/1770704226337.png




